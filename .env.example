# ===== Bắt buộc =====
# Token của bot, lấy từ https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ID kênh Discord nơi bot sẽ gửi tin nhắn nhắc nhở
# (Bật Developer Mode trong Discord, chuột phải vào kênh -> Copy Channel ID)
CHANNEL_ID=123456789012345678

# Không cần khai báo người dùng ở đây nữa - mỗi người tự gõ /dangky
# trong Discord để đăng ký nhận nhắc nhở (xem README).

# ===== Tùy chọn =====
# Các mốc giờ nhắc nhở trong ngày, định dạng HH:MM, cách nhau bởi dấu phẩy
REMINDER_TIMES=08:00,10:30,13:00,15:30,18:00,20:30

# Sau bao nhiêu phút thì nhắc lại nếu chưa bấm nút gì cả, tối đa mấy lần
BUTTON_REMINDER_INTERVAL_MINUTES=15
BUTTON_REMINDER_MAX=2

# Sau khi bấm "Chưa uống": bao nhiêu phút thì hỏi lại "đã uống chưa", tối đa mấy lần
DRINK_CONFIRM_INTERVAL_MINUTES=5
DRINK_CONFIRM_MAX=2

# Từ giờ này trở đi (giờ VN), không nhắc thêm nữa trong ngày
QUIET_HOUR=22:30

# Danh sách Discord User ID được coi là admin của BOT (không liên quan role Discord),
# cách nhau bởi dấu phẩy nếu có nhiều admin. Chỉ admin mới dùng được lệnh /thongbao.
ADMIN_USER_IDS=524848816168632321

# Các mốc giờ gửi fact vui về uống nước (độc lập với lịch nhắc uống nước)
FACTS_TIMES=07:00,11:30,15:00,21:00

# API key Gemini (lấy free tại https://aistudio.google.com/app/apikey) để bot tự sinh fact mới.
# Để trống thì bot sẽ luôn dùng danh sách fact có sẵn (tĩnh) trong messages.py.
GEMINI_API_KEY=

# Prompt gửi cho Gemini để sinh fact - tùy chỉnh thoải mái, không cần sửa code.
# Để trống thì dùng prompt mặc định có sẵn trong code.
PROMPT_FACT=

# ===== Tính năng trò chuyện (@mention bot) =====
# Số tin nhắn gần nhất giữ lại làm ngữ cảnh hội thoại, mỗi người riêng
CHAT_HISTORY_LIMIT=20

# System prompt cho tính năng trò chuyện - để trống thì dùng mặc định có sẵn trong chat.py
PROMPT_CHAT=

# Múi giờ (mặc định Việt Nam)
TIMEZONE=Asia/Ho_Chi_Minh
